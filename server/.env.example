# VIRAAS production server configuration — copy values into the existing Vercel project settings.
# Never commit actual secret values. No VITE_* variable is needed for any credential below.

# Existing VIRAAS Supabase/PostgreSQL and Supabase Email Auth.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=SUPABASE_PUBLISHABLE_OR_ANON_KEY
VIRAAS_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# Public asset/payment callback origin. On Vercel, VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL is
# used automatically when PUBLIC_BASE_URL is omitted. For production PayU, explicitly set:
# PUBLIC_BASE_URL=https://viraas-in.vercel.app

# Real Runware-hosted FLUX virtual try-on. Generation remains closed until all three settings are
# valid AND the Runware organization-level ZDR service has been enabled and verified.
TRYON_MODE=runware-flux
RUNWARE_API_KEY=server-side-runware-api-key
RUNWARE_FLUX_MODEL=bfl:flux@vto
RUNWARE_ZDR=false
# RUNWARE_API_URL=https://api.runware.ai/v1
TRYON_TIMEOUT_MS=60000
RUNWARE_OUTPUT_TTL=120

# PayU India Hosted Checkout for a fixed ₹20 = one additional Try-On credit.
# Use test only for an explicitly configured PayU test merchant; production is the default.
PAYU_ENV=production
PAYU_MERCHANT_KEY=server-side-payu-merchant-key
PAYU_MERCHANT_SALT=server-side-payu-merchant-salt

# Apply all ordered PostgreSQL migrations manually before deployment:
# npm run db:migrate
# Required production migrations include 001_core, 002_incomplete_accounts, and
# 003_tryon_credits_payu. The deploy build deliberately never runs migrations.
