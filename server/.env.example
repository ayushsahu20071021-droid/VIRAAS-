# VIRAAS AI Try-On — server-side configuration.
# Copy to server/.env (or set these in your host's env). NEVER commit real keys.
# The frontend never sees any of these values.

# ---------------------------------------------------------------------------
# Provider selection: demo (default) | flux | custom
#   demo  = no AI call, labelled layout preview only (safe default, no key needed)
#   flux  = FLUX VTO (Black Forest Labs) — best for coordinated Indian ethnic sets
#   custom= any other REST provider you host/verify yourself
# ---------------------------------------------------------------------------
TRYON_MODE=demo

# Optional: absolute base URL of the deployed VIRAAS site, used only if a garment
# reference image is not present on disk (normally it is, and is inlined as base64).
# PUBLIC_BASE_URL=https://your-viraas-domain.example

# Shared timeout for any live provider (ms).
TRYON_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# FLUX VTO (Black Forest Labs) — used when TRYON_MODE=flux
# Docs: https://docs.bfl.ai/flux_tools/flux_vto   Pricing: https://bfl.ai/pricing
# ---------------------------------------------------------------------------
# BFL_API_KEY=your-bfl-api-key

# Regional base URL: https://api.bfl.ai (default) | https://api.eu.bfl.ai | https://api.us.bfl.ai
# For strict privacy use a Zero-Data-Retention endpoint (BFL Enterprise/dedicated, or a verified
# ZDR reseller) and point BFL_API_BASE at it.
# BFL_API_BASE=https://api.bfl.ai

# REQUIRED privacy acknowledgement. The adapter REFUSES to send user photos unless this is "true".
# Set it to true ONLY when the endpoint above is a Zero-Data-Retention deployment whose
# no-training / no-retention / deletion terms you have verified in writing.
# (The STANDARD BFL API trains on inputs by default and is NOT acceptable for customer photos.)
# BFL_VTO_ZDR=false

# ---------------------------------------------------------------------------
# Custom provider — used when TRYON_MODE=custom
# The adapter POSTs { person_image, garment_image, garment_description, outfit_id, gender }
# with Authorization: Bearer <TRYON_API_KEY>, and reads result_image | output | image back.
# ---------------------------------------------------------------------------
# TRYON_API_URL=https://your-provider.example/v1/try-on
# TRYON_API_KEY=your-provider-key
# TRYON_PROVIDER=your-provider-name
