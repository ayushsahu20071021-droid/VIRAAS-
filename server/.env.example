# VIRAAS AI Try-On — server-side configuration.
# Copy to server/.env (or set these in your host's env). NEVER commit real keys.
# The frontend never sees any of these values.

# ---------------------------------------------------------------------------
# Provider selection: demo (default) | flux | runware-flux | custom
#   demo         = no AI call, labelled layout preview only (safe default, no key needed)
#   flux         = FLUX VTO via Black Forest Labs API (trains on inputs by default — ZDR-only)
#   runware-flux = FLUX VTO via Runware (hosted; never trains on data; ZDR available) [RECOMMENDED]
#   custom       = any other REST provider you host/verify yourself
# ---------------------------------------------------------------------------
TRYON_MODE=demo

# Optional: absolute base URL of the deployed VIRAAS site, used only if a garment
# reference image is not present on disk (normally it is, and is inlined as base64).
# PUBLIC_BASE_URL=https://your-viraas-domain.example

# Shared timeout for any live provider (ms).
TRYON_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# FLUX VTO (Black Forest Labs) — used when TRYON_MODE=flux
# Docs: https://docs.bfl.ai/flux_tools/flux_vto   Pricing: https://bfl.ai/pricing
# ---------------------------------------------------------------------------
# BFL_API_KEY=your-bfl-api-key

# Regional base URL: https://api.bfl.ai (default) | https://api.eu.bfl.ai | https://api.us.bfl.ai
# For strict privacy use a Zero-Data-Retention endpoint (BFL Enterprise/dedicated, or a verified
# ZDR reseller) and point BFL_API_BASE at it.
# BFL_API_BASE=https://api.bfl.ai

# REQUIRED privacy acknowledgement. The adapter REFUSES to send user photos unless this is "true".
# Set it to true ONLY when the endpoint above is a Zero-Data-Retention deployment whose
# no-training / no-retention / deletion terms you have verified in writing.
# (The STANDARD BFL API trains on inputs by default and is NOT acceptable for customer photos.)
# BFL_VTO_ZDR=false

# ---------------------------------------------------------------------------
# Runware FLUX VTO — used when TRYON_MODE=runware-flux   [RECOMMENDED]
# Docs: https://runware.ai/docs/models/bfl-flux-virtual-try-on
#       https://runware.ai/docs/platform/zero-data-retention
# Runware never uses API data to train models (with or without ZDR). ZDR (enterprise, org-level)
# additionally means input media is not retained and outputs are deleted at their TTL. The adapter
# requests outputType=dataURI, so results come back inline and no file is stored.
# ---------------------------------------------------------------------------
# RUNWARE_API_KEY=your-runware-api-key
RUNWARE_FLUX_MODEL=bfl:flux@vto
# RUNWARE_API_URL=https://api.runware.ai/v1

# REQUIRED privacy acknowledgement. The adapter REFUSES to send user photos unless this is "true".
# Set it to true ONLY when your Runware organization has Zero-Data-Retention enabled
# (request it via Runware "Contact Sales") and you have verified the terms.
# RUNWARE_ZDR=false

# Output TTL in seconds for the generated result (default 120). With outputType=dataURI nothing is
# stored, so this only matters if a URL fallback is ever used.
# RUNWARE_OUTPUT_TTL=120

# ---------------------------------------------------------------------------
# PAYMENT GATE (customer pays VIRAAS -> server verifies -> authorizes ONE Try-On -> Runware)
# The customer pays VIRAAS; VIRAAS pays Runware by usage. The customer NEVER pays Runware directly.
# ---------------------------------------------------------------------------
# Whether a real AI Try-On requires a verified, paid, one-time authorization.
# Default false so the demo/preview flow keeps working and NO money is collected.
TRYON_PAYMENT_REQUIRED=false

# Customer-facing Try-On price (configuration only — no margin/profit math is computed anywhere).
# Change freely without touching the Runware integration.
TRYON_PRICE_INR=20
TRYON_CURRENCY=INR

# Payment gateway selection: mock (default; test-only, moves NO money) | razorpay | cashfree
# Provider-agnostic: neither gateway is hard-coded into the flow; plug one in later by adding its
# credentials below. No real gateway is "configured" until its keys are present.
PAYMENT_PROVIDER=mock

# Mock gateway (LOCAL TESTS ONLY) — signs its webhook with HMAC over this secret. Never production.
# MOCK_PAYMENT_SECRET=mock-webhook-secret-dev-only

# Razorpay (fill when onboarding completes; adapter is a documented stub until then).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Cashfree (fill when onboarding completes; adapter is a documented stub until then).
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Custom provider — used when TRYON_MODE=custom
# The adapter POSTs { person_image, garment_image, garment_description, outfit_id, gender }
# with Authorization: Bearer <TRYON_API_KEY>, and reads result_image | output | image back.
# ---------------------------------------------------------------------------
# TRYON_API_URL=https://your-provider.example/v1/try-on
# TRYON_API_KEY=your-provider-key
# TRYON_PROVIDER=your-provider-name
